      name: "ask_question"
      arguments_json: "{\"questions\":[{\"is_multi_select\":false, \"options\":[\"(Recommended) Start all personal club fields blank until synced\", \"Keep a separate opt-in demo mode toggle\", \"Prompt for club sync modal immediately on launch\"], \"question\":\"How should your personal Ultimate Team data (coins, points, SP, squad, and duplicate storage) appear before you sync or enter it?\"}, {\"is_multi_select\":false, \"options\":[\"(Recommended) Leave unverified stats or prices blank with a sync trigger\", \"Hide unverified players completely from all lists\", \"Require live search verification before displaying any card\"], \"question\":\"When an FC 27 player stat, price, or SBC detail cannot be 100% verified for FC 27 on Xbox Series S, how should the app handle it?\"}, {\"is_multi_select\":true, \"options\":[\"(Recommended) Companion Web App JSON and Paletools paste\", \"(Recommended) Voice dictation and quick manual entry inputs\", \"(Recommended) Antigravity v2.25 browser MCP live DOM inspection\", \"Google Drive and Firestore cloud restore\"], \"question\":\"Which methods do you want enabled to populate your blank Xbox Series S Ultimate Team club profile?\"}], \"toolAction\":\"Asking clarifying questions for Xbox Series S and zero-hallucination club state\", \"toolSummary\":\"Ask clarifying questions for plan\"}"
