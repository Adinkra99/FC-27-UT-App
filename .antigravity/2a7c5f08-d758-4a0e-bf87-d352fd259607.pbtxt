      thinking_signature: "\022\233\020\n\230\020\001i\024}\023\320\302\345\3412$\321\203X\337\"\\\347.:\v\213:\250\025\022\275\025\3234H3\036o\034;\333\346\217s\322\232X\275\340\277\342\374\205\250QF\004R\266\310k\226\243\r\360\0019\360\222\215\002\227\204\254OI\354\365\026\005\321\003\366X/\352{\023\277\t\323B3,\242\373d\363u\365\236h\334;\202\2211\024V\033\312< \'\236\b\324\310\v\210N\225l\002O\vT\334\225\210-|\304\006\270i.D\252\201#_e\375,mJ1B\240\\\265\311\327b\272\327\357n<\353+d\020\217X\272\223}2\024\341\023\212\006q@[\2512ozY25\r\022\321\302\307\241|\025v\265O\260\a\241w\313\325\335P\023B\037\021\\\222X\225K\350h]4\270\354\213\357n\330\302\217\250\250\372\315\346:\367\365\362w\026\352\276\340\304\035\232\337#=O\350\227\031>\0015zJ\246\nK:\205\261\243\364z\374\017\307\302\016e\3438\3416\200\267$\200#\332Jj:\242G.\'Lq\303_\021\325E\327\227|\341\2731\b\224/\0328*:\373\274\234\033\334\245\375:\301Dg\306l\nu\277\2339Z\305\a\233-\006\265\313<\004\354sj\367\323\034\001\330i4\247\224(\\\262\\\r\245\b\357\024\244\023\247\244\300\003\226\236\244vf\262>cs\337O\203\300W\232(\r@\300\035\2679\016\363\201y\313e\321Z\a\261\317\315Q\267j\031\037\037\241\0250|G<(OQ\022O\302p1\222\371\022\375\214&\246+\221\317\301\357\3434\374\f\356\277a\257\242\333!>?\306Qu5oP\371\273\321\023\335\225kw3\375\036\330\221\250\240\350\225\354\002\313\331\177h\312zt\353\003yB\337\300\225\215\221@\215\ru\037\035\032\271\214r\244=\206\3325\276\213\327Nu\252\375\264i\270\031lE\271(|\226\275\220 N\fM\341x<\003N\037\275\356\032\374\310d\027\337Y\364\255\270fg\235\252\256&\270\n\025I\025\300\b\256\345b\004\332\023\2337a\003\r%T\203\243\370\025ZM\222\206\335\311\272\217\363\317\254\223\277\336\260k\346\323\031\017PFT ?\2453\257\307\234\377\231W\377\355aN\023N\347r\223\245\325\365^Ys \2269\001\326\021\376m\332\203\253\302$\340\"sJ\274\234\277\003y\200\273\227\363\366\303\\ne\n(NO9\231\242\367O\346S\312(\313b\267\255\227\031\0066\275\365\210\335\a\271\357\245{\361\262K\347\237\311\004:+3\305\\n\310\025X+