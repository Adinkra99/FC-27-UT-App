            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 5. Implementation Sequence & Plan"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. **Step 1: Firebase Provisioning**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Call `show_aistudio_ui` with `ui_type: \"firebase_setup\"` and verify user approval."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Provision Firestore and Auth via `rpc_action` (`ProvisionFirebase`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Create `firebase-blueprint.json` and hardened `firestore.rules`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. **Step 2: Server-Side Gemini Intelligence**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Configure `server.ts` with Express and `@google/genai` using `gemini-4-argon` (`ThinkingLevel.HIGH`) and `gemini-3.8-flash`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Setup API endpoints `/api/gemini/market-advisor`, `/api/gemini/sbc-solver`, `/api/gemini/quick-query`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "3. **Step 3: FC 27 Console Database & Chemistry Engine**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Construct robust dataset of FC 27 console meta players, promos (Trailblazers, TOTW, Icons, Heroes), and realistic market prices."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Implement authentic 33/33 chemistry engine (calculating 1/2/3 threshold points for club, league, nation, manager, and icon bonuses)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "4. **Step 4: FUTBIN-Style Terminal UI & Mobile Viewport**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Develop dense FUTBIN desktop layout with live price tickers, market index widget, and player search filters."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Implement interactive Squad Builder pitch with drag/swap, chem styles, bench, and squad cost."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Build AI SBC Solver and Club Fodder optimizer with untradeables integration."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Build Gemini Market Trader terminal with interactive flip tracking and alert setting."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Build Club Companion Sync and Gallery Grind Loop assistant."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Ensure fluid responsiveness across ZenBook multi-screen and mobile screen resolutions."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "5. **Step 5: Verification & Compilation**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Run `compile_applet` and verify zero errors, full interactive handlers, and seamless user experience."
