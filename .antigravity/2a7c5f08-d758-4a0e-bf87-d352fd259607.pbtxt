            lines {
              text: "- **FC27Player**: ID, name, rating, position, altPositions, club, league, nation, cardType (Gold Rare, TOTW, Trailblazers, Icon, Centurions, etc.), consolePrice, priceHistory (24h/7d timestamps), statRadar (PAC, SHO, PAS, DRI, DEF, PHY)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Squad**: ID, name, formation (`4-3-3`, `4-4-2`, `4-2-3-1`, `3-5-2`, `5-3-2`), slots (11 starting + bench), totalChemistry (0-33), totalCost, chemBreakdown."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
