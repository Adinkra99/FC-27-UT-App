            }
            lines {
              text: "- **Combinatorial Rating & Chemistry Solver**: Powered by `gemini-4-argon` (`ThinkingLevel.HIGH`) and a deterministic rating matrix calculator to compute the cheapest rating combinations (e.g. combining 84s and 87s to hit an 86 squad rating requirement with required chemistry)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
