  code_action {
    action_spec {
      create_file {
        instruction: "{\n  \"entities\": {\n    \"UserClubState\": {\n      \"title\": \"UserClubState\",\n      \"description\": \"Stores the user\'s synced EA Sports FC 27 Ultimate Team Xbox Series S club state. Unknown fields remain null (blank) rather than guessed.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"ownerId\": {\n          \"type\": \"string\",\n          \"description\": \"Firebase Auth UID of the club owner.\",\n          \"minLength\": 1,\n          \"maxLength\": 128,\n          \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\"\n        },\n        \"consolePlatform\": {\n          \"type\": \"string\",\n          \"description\": \"Target console market platform (locked to Xbox Series S).\",\n          \"enum\": [\"Xbox Series S\"]\n        },\n        \"clubName\": {\n          \"type\": [\"string\", \"null\"],\n          \"description\": \"Display name of the user\'s FC 27 Ultimate Team club, or null if not provided.\",\n          \"minLength\": 1,\n          \"maxLength\": 64\n        },\n        \"coins\": {\n          \"type\": [\"integer\", \"null\"],\n          \"description\": \"Current Xbox Series S Coin balance (e.g. 35000), or null if blank.\"\n        },\n        \"fifaPoints\": {\n          \"type\": [\"integer\", \"null\"],\n          \"description\": \"Current FC/FIFA Points balance, or null if blank.\"\n        },\n        \"rivalsDivision\": {\n          \"type\": [\"string\", \"null\"],\n          \"description\": \"Current Division Rivals division (e.g. \'Division 3\' or \'Elite\'), or null if blank.\",\n          \"minLength\": 1,\n          \"maxLength\": 32\n        },\n        \"dailySp\": {\n          \"type\": [\"integer\", \"null\"],\n          \"description\": \"Match-earned Season Points today (0-850 SP cap), or null if blank.\"\n        },\n        \"galleryLevel\": {\n          \"type\": [\"integer\", \"null\"],\n          \"description\": \"Overall FUT Gallery collection level (1-100), or null if blank.\"\n        },\n        \"activeFormation\": {\n          \"type\": \"string\",\n          \"description\": \"Currently selected tactical formation.\",\n          \"minLength\": 3,\n          \"maxLength\": 32\n        },\n        \"antigravityVersion\": {\n          \"type\": \"string\",\n          \"description\": \"Resolved Antigravity 2.0 Desktop App firmware version at T=0.\",\n          \"minLength\": 1,\n          \"maxLength\": 32\n        },\n        \"fc27PatchVersion\": {\n          \"type\": \"string\",\n          \"description\": \"Resolved EA Sports FC 27 Title Update / Live Tuning version at T=0.\",\n          \"minLength\": 1,\n          \"maxLength\": 64\n        },\n        \"lastT0Anchor\": {\n          \"type\": \"string\",\n          \"description\": \"British Time (Europe/London) ISO timestamp of last sync.\",\n          \"minLength\": 1,\n          \"maxLength\": 64\n        },\n        \"createdAt\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\",\n          \"description\": \"Server timestamp of initial club creation.\"\n        },\n        \"updatedAt\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\",\n          \"description\": \"Server timestamp of latest sync mutation.\"\n        }\n      },\n      \"required\": [\n        \"ownerId\",\n        \"consolePlatform\",\n        \"clubName\",\n        \"coins\",\n        \"fifaPoints\",\n        \"rivalsDivision\",\n        \"dailySp\",\n        \"galleryLevel\",\n        \"activeFormation\",\n        \"antigravityVersion\",\n        \"fc27PatchVersion\",\n        \"lastT0Anchor\",\n        \"createdAt\",\n        \"updatedAt\"\n      ]\n    },\n    \"TrackedInvestment\": {\n      \"title\": \"TrackedInvestment\",\n      \"description\": \"Stores a user\'s tracked FC 27 Xbox Series S market flip, Holographic arbitrage position, or Gallery Rent-and-Flip target.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"ownerId\": {\n          \"type\": \"string\",\n          \"description\": \"Firebase Auth UID of the investor.\",\n          \"minLength\": 1,\n          \"maxLength\": 128,\n          \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\"\n        },\n        \"playerId\": {\n          \"type\": \"string\",\n          \"description\": \"Unique FC 27 Xbox Series S player identifier.\",\n          \"minLength\": 1,\n          \"maxLength\": 64,\n          \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\"\n        },\n        \"playerName\": {\n          \"type\": \"string\",\n          \"description\": \"Player display name.\",\n          \"minLength\": 1,\n          \"maxLength\": 80\n        },\n        \"rating\": {\n          \"type\": \"integer\",\n          \"description\": \"Player OVR rating (45-99).\"\n        },\n        \"rarity\": {\n          \"type\": \"string\",\n          \"description\": \"Card rarity including Regular/Pristine Holographic.\",\n          \"minLength\": 1,\n          \"maxLength\": 40\n        },\n        \"buyPrice\": {\n          \"type\": \"integer\",\n          \"description\": \"Xbox Series S purchase or target bid price in coins.\"\n        },\n        \"targetSellPrice\": {\n          \"type\": \"integer\",\n          \"description\": \"Target sale price on Xbox Series S before 5% EA tax.\"\n        },\n        \"quantity\": {\n          \"type\": \"integer\",\n          \"description\": \"Number of cards tracked (1-100).\"\n        },\n        \"status\": {\n          \"type\": \"string\",\n          \"description\": \"Lifecycle status of the trade.\",\n          \"enum\": [\"active\", \"target_hit\", \"sold\"]\n        },\n        \"createdAt\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\",\n          \"description\": \"Server timestamp of creation.\"\n        },\n        \"updatedAt\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\",\n          \"description\": \"Server timestamp of last update.\"\n        }\n      },\n      \"required\": [\n        \"ownerId\",\n        \"playerId\",\n        \"playerName\",\n        \"rating\",\n        \"rarity\",\n        \"buyPrice\",\n        \"targetSellPrice\",\n        \"quantity\",\n        \"status\",\n        \"createdAt\",\n        \"updatedAt\"\n      ]\n    }\n  },\n  \"firestore\": {\n    \"/users/{userId}\": {\n      \"schema\": { \"$ref\": \"#/entities/UserClubState\" },\n      \"description\": \"Root user club document keyed by the authenticated user\'s UID.\"\n    },\n    \"/users/{userId}/investments/{investmentId}\": {\n      \"schema\": { \"$ref\": \"#/entities/TrackedInvestment\" },\n      \"description\": \"Subcollection of tracked FC 27 Xbox Series S market investments owned by the parent user.\"\n    }\n  }\n}\n"
