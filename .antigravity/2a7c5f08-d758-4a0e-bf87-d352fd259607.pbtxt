      arguments_json: "{\"CodeContent\":\"{\\n  \\\"$schema\\\": \\\"https://antigravity.google/schemas/v2.25/mcp_config.schema.json\\\",\\n  \\\"antigravityFirmwareTarget\\\": \\\"2.25\\\",\\n  \\\"temporalAnchoringMode\\\": \\\"DYNAMIC_T0_BRITISH_TIME\\\",\\n  \\\"mcpServers\\\": {\\n    \\\"chrome-devtools-mcp\\\": {\\n      \\\"command\\\": \\\"npx\\\",\\n      \\\"args\\\": [\\\"-y\\\", \\\"@modelcontextprotocol/server-chrome-devtools\\\", \\\"--port\\\", \\\"9222\\\"],\\n      \\\"description\\\": \\\"Antigravity v2.25 native /browser subagent bridge for live EA FC 27 Companion Web App DOM sync and FUTBIN hourly chart inspection.\\\"\\n    },\\n    \\\"playwright-futbin-mcp\\\": {\\n      \\\"command\\\": \\\"npx\\\",\\n      \\\"args\\\": [\\\"-y\\\", \\\"@modelcontextprotocol/server-playwright\\\"],\\n      \\\"description\\\": \\\"Scrapes JS-rendered FUTBIN FC 27 Console endpoints (Market Index 100, Gallery Sets & Tags, PGP, Evolutions) and FotMob 2026-27 squad transfers.\\\"\\n    },\\n    \\\"fetch-patch-sbc-mcp\\\": {\\n      \\\"command\\\": \\\"npx\\\",\\n      \\\"args\\\": [\\\"-y\\\", \\\"@modelcontextprotocol/server-fetch\\\"],\\n      \\\"description\\\": \\\"High-speed ingestion of futbin.com/27/cheapest-by-rating, active SBC requirements, and EA Sports FC 27 Title Update Pitch Notes at 18:00 BST.\\\"\\n    },\\n    \\\"sqlite-fc27-cache-mcp\\\": {\\n      \\\"command\\\": \\\"uvx\\\",\\n      \\\"args\\\": [\\\"mcp-server-sqlite\\\", \\\"--db-path\\\", \\\"./fc27_futbin_mirror.db\\\"],\\n      \\\"description\\\": \\\"Local Asus ZenBook UX482 SQLite cache serving <2ms queries for Streamlined SBC Item Score math, Holographic multipliers, and 31 Roles++ synthesis.\\\"\\n    },\\n    \\\"memory-transfer-graph-mcp\\\": {\\n      \\\"command\\\": \\\"npx\\\",\\n      \\\"args\\\": [\\\"-y\\\", \\\"@modelcontextprotocol/server-memory\\\"],\\n      \\\"description\\\": \\\"Anti-autoregressive 2026-27 Season Transfer Knowledge Graph (verifying e.g. Rodri at FC Barcelona) and active Evolution Chain locks.\\\"\\n    },\\n    \\\"google-drive-workspace-mcp\\\": {\\n      \\\"command\\\": \\\"npx\\\",\\n      \\\"args\\\": [\\\"-y\\\", \\\"@modelcontextprotocol/server-google-drive\\\"],\\n      \\\"description\\\": \\\"Auto-syncs Paletools/FUTClubAnalyzer Web App JSON club exports, SBC solutions, and 18:00 BST market digests with Google Drive.\\\"\\n    },\\n    \\\"github-ut-tools-mcp\\\": {\\n      \\\"command\\\": \\\"npx\\\",\\n      \\\"args\\\": [\\\"-y\\\", \\\"@modelcontextprotocol/server-github\\\"],\\n      \\\"description\\\": \\\"Monitors FUTClubAnalyzer, AutoSBC, and FC-Tracker repositories for Web App schema changes.\\\"\\n    }\\n  },\\n  \\\"scheduledHooks\\\": [\\n    {\\n      \\\"id\\\": \\\"daily-1800-bst-content-drop\\\",\\n      \\\"cron\\\": \\\"0 18 * * *\\\",\\n      \\\"timezone\\\": \\\"Europe/London\\\",\\n      \\\"action\\\": \\\"spawn_subagents\\\",\\n      \\\"subagents\\\": [\\\"Subagent-FUTBIN-Prices\\\", \\\"Subagent-FotMob-Transfers\\\", \\\"Subagent-Evo-Sim\\\"]\\n    }\\n  ]\\n}\\n\", \"Description\":\"Create .agents/mcp_config.json for Google Antigravity 2.25 Desktop App orchestration\", \"Overwrite\":true, \"TargetFile\":\"/.agents/mcp_config.json\", \"toolAction\":\"Creating .agents/mcp_config.json\", \"toolSummary\":\"Create Antigravity 2.25 MCP config file\"}"
      original_name: "write_to_file"
