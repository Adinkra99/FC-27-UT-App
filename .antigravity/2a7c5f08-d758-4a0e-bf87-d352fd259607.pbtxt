  code_action {
    action_spec {
      create_file {
        instruction: "rules_version = \'2\';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    // 1. Global Safety Net (Default Deny)\n    match /{document=**} {\n      allow read, write: if false;\n    }\n\n    // 2. Hardened Primitives\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isVerifiedUser() {\n      return isSignedIn() && request.auth.token.email_verified == true;\n    }\n\n    function isValidId(id) {\n      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches(\'^[a-zA-Z0-9_\\\\-]+$\');\n    }\n\n    function incoming() {\n      return request.resource.data;\n    }\n\n    function existing() {\n      return resource.data;\n    }\n\n    // 3. Entity Blueprints (Anti-Update-Gap & Nullable Blank-Safe Club State)\n    function isValidUserClubState(data) {\n      return data.keys().hasAll([\n        \'ownerId\', \'consolePlatform\', \'clubName\', \'coins\', \'fifaPoints\',\n        \'rivalsDivision\', \'dailySp\', \'galleryLevel\', \'activeFormation\',\n        \'antigravityVersion\', \'fc27PatchVersion\', \'lastT0Anchor\',\n        \'createdAt\', \'updatedAt\'\n      ]) &&\n      data.keys().hasOnly([\n        \'ownerId\', \'consolePlatform\', \'clubName\', \'coins\', \'fifaPoints\',\n        \'rivalsDivision\', \'dailySp\', \'galleryLevel\', \'activeFormation\',\n        \'antigravityVersion\', \'fc27PatchVersion\', \'lastT0Anchor\',\n        \'createdAt\', \'updatedAt\'\n      ]) &&\n      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&\n      data.ownerId.matches(\'^[a-zA-Z0-9_\\\\-]+$\') &&\n      data.ownerId == request.auth.uid &&\n      data.consolePlatform == \'Xbox Series S\' &&\n      (data.clubName == null || (data.clubName is string && data.clubName.size() >= 1 && data.clubName.size() <= 64)) &&\n      (data.coins == null || (data.coins is int && data.coins >= 0 && data.coins <= 100000000)) &&\n      (data.fifaPoints == null || (data.fifaPoints is int && data.fifaPoints >= 0 && data.fifaPoints <= 1000000)) &&\n      (data.rivalsDivision == null || (data.rivalsDivision is string && data.rivalsDivision.size() >= 1 && data.rivalsDivision.size() <= 32)) &&\n      (data.dailySp == null || (data.dailySp is int && data.dailySp >= 0 && data.dailySp <= 850)) &&\n      (data.galleryLevel == null || (data.galleryLevel is int && data.galleryLevel >= 1 && data.galleryLevel <= 100)) &&\n      data.activeFormation is string && data.activeFormation.size() >= 3 && data.activeFormation.size() <= 32 &&\n      data.antigravityVersion is string && data.antigravityVersion.size() >= 1 && data.antigravityVersion.size() <= 32 &&\n      data.fc27PatchVersion is string && data.fc27PatchVersion.size() >= 1 && data.fc27PatchVersion.size() <= 64 &&\n      data.lastT0Anchor is string && data.lastT0Anchor.size() >= 1 && data.lastT0Anchor.size() <= 64 &&\n      data.createdAt is timestamp &&\n      data.updatedAt is timestamp;\n    }\n\n    function isValidTrackedInvestment(data) {\n      return data.keys().hasAll([\n        \'ownerId\', \'playerId\', \'playerName\', \'rating\', \'rarity\',\n        \'buyPrice\', \'targetSellPrice\', \'quantity\', \'status\',\n        \'createdAt\', \'updatedAt\'\n      ]) &&\n      data.keys().hasOnly([\n        \'ownerId\', \'playerId\', \'playerName\', \'rating\', \'rarity\',\n        \'buyPrice\', \'targetSellPrice\', \'quantity\', \'status\',\n        \'createdAt\', \'updatedAt\'\n      ]) &&\n      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&\n      data.ownerId.matches(\'^[a-zA-Z0-9_\\\\-]+$\') &&\n      data.ownerId == request.auth.uid &&\n      data.playerId is string && data.playerId.size() >= 1 && data.playerId.size() <= 64 &&\n      data.playerId.matches(\'^[a-zA-Z0-9_\\\\-]+$\') &&\n      data.playerName is string && data.playerName.size() >= 1 && data.playerName.size() <= 80 &&\n      data.rating is int && data.rating >= 45 && data.rating <= 99 &&\n      data.rarity is string && data.rarity.size() >= 1 && data.rarity.size() <= 40 &&\n      data.buyPrice is int && data.buyPrice >= 150 && data.buyPrice <= 15000000 &&\n      data.targetSellPrice is int && data.targetSellPrice >= 150 && data.targetSellPrice <= 15000000 &&\n      data.quantity is int && data.quantity >= 1 && data.quantity <= 100 &&\n      data.status is string && data.status.size() <= 20 &&\n      data.status in [\'active\', \'target_hit\', \'sold\'] &&\n      data.createdAt is timestamp &&\n      data.updatedAt is timestamp;\n    }\n\n    // 4. Root User Club Collection\n    match /users/{userId} {\n      allow get: if isVerifiedUser() && isValidId(userId) && request.auth.uid == userId && existing().ownerId == request.auth.uid;\n\n      allow create: if isVerifiedUser() &&\n        isValidId(userId) &&\n        request.auth.uid == userId &&\n        isValidUserClubState(incoming()) &&\n        incoming().createdAt == request.time &&\n        incoming().updatedAt == request.time;\n\n      allow update: if isVerifiedUser() &&\n        isValidId(userId) &&\n        request.auth.uid == userId &&\n        isValidUserClubState(incoming()) &&\n        existing().ownerId == request.auth.uid &&\n        incoming().ownerId == existing().ownerId &&\n        incoming().createdAt == existing().createdAt &&\n        incoming().updatedAt == request.time && (\n          // Action 1: Sync Nullable Xbox Series S Wallet, Division, SP & Gallery Progress\n          incoming().diff(existing()).affectedKeys().hasOnly([\n            \'consolePlatform\', \'clubName\', \'coins\', \'fifaPoints\',\n            \'rivalsDivision\', \'dailySp\', \'galleryLevel\',\n            \'activeFormation\', \'antigravityVersion\', \'fc27PatchVersion\',\n            \'lastT0Anchor\', \'updatedAt\'\n          ])\n        );\n\n      allow delete: if isVerifiedUser() && isValidId(userId) && request.auth.uid == userId && existing().ownerId == request.auth.uid;\n\n      // 5. Subcollection: Tracked Investments (Master Gate Enforced)\n      match /investments/{investmentId} {\n        function isParentClubOwner() {\n          return exists(/databases/$(database)/documents/users/$(userId)) &&\n            get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;\n        }\n\n        allow get: if isVerifiedUser() &&\n          isValidId(userId) &&\n          isValidId(investmentId) &&\n          request.auth.uid == userId &&\n          existing().ownerId == request.auth.uid &&\n          isParentClubOwner();\n\n        allow list: if isVerifiedUser() &&\n          request.auth.uid == userId &&\n          existing().ownerId == request.auth.uid;\n\n        allow create: if isVerifiedUser() &&\n          isValidId(userId) &&\n          isValidId(investmentId) &&\n          request.auth.uid == userId &&\n          isValidTrackedInvestment(incoming()) &&\n          incoming().createdAt == request.time &&\n          incoming().updatedAt == request.time &&\n          isParentClubOwner();\n\n        allow update: if isVerifiedUser() &&\n          isValidId(userId) &&\n          isValidId(investmentId) &&\n          request.auth.uid == userId &&\n          isValidTrackedInvestment(incoming()) &&\n          existing().ownerId == request.auth.uid &&\n          incoming().ownerId == existing().ownerId &&\n          incoming().playerId == existing().playerId &&\n          incoming().createdAt == existing().createdAt &&\n          incoming().updatedAt == request.time &&\n          existing().status != \'sold\' &&\n          isParentClubOwner() && (\n            // Action 1: Update Trade Status or Target Price\n            incoming().diff(existing()).affectedKeys().hasOnly([\n              \'buyPrice\', \'targetSellPrice\', \'quantity\', \'status\', \'updatedAt\'\n            ])\n          );\n\n        allow delete: if isVerifiedUser() &&\n          isValidId(userId) &&\n          isValidId(investmentId) &&\n          request.auth.uid == userId &&\n          existing().ownerId == request.auth.uid &&\n          isParentClubOwner();\n      }\n    }\n  }\n}\n"
        path {
          absolute_uri: "file:///firestore.rules"
        }
        overwrite: true
      }
    }
