            lines {
              text: "export function calculateEaTaxMetrics(buyPrice: number, sellPrice: number) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const eaTax = Math.round(sellPrice * 0.05);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const netAfterTax = sellPrice - eaTax;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const netProfit = netAfterTax - buyPrice;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const breakEvenSalePrice = Math.ceil(buyPrice / 0.95);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const roiPct = buyPrice > 0 ? Number(((netProfit / buyPrice) * 100).toFixed(2)) : 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    buyPrice,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    sellPrice,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
