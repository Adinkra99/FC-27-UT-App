            lines {
              text: "  - FC Neon Accent: High-visibility Hyper Emerald (`#00ff87` / `#0df28e`) for chem points, positive margins, and CTAs"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  - Gold / Special Card Accent: EA FC Gold Metallic (`#e5b94c` / `#ffd700`)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  - Warning / EA Tax / Drop: Crisp Crimson (`#ff4d4f`)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  - Typography: Condensed athletic heading style paired with monospace tabular figures (`font-mono tabular-nums`) for currency, prices, and chemistry tallies."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "- **ZenBook Dual-Pane & Mobile Ergonomics**:"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  - Full-width dense desktop multi-column terminal with collapsible side tickers (Top Gainers, Fodder Index, Live Price Alerts)."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  - Mobile touch navigation with sticky thumb-friendly bottom bar (Squad, Market, SBCs, Trader, Club) adhering to the 15% sticky cap."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  - Large touch targets ($\\ge 44\\text{px}$) for player swapping, quick-sell/buy simulations, and filter toggles."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  - Dominant Canvas: Deep Midnight Slate (`#0a0e17` and `#111827`)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - Structural Cards & Tables: Muted Dark Navy (`#172033`) with subtle 1px border (`#1f2d47`)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - FC Neon Accent: High-contrast Pitch Emerald (`#00ff87`) for chemistry points, profit green, and primary actions"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - Premium Promo Accent: Metallic Gold (`#f59e0b` / `#fbbf24`) for Icons and TOTW items"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - Negative Delta / EA Tax: Crimson Red (`#ef4444`)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Mobile Ergonomics**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - Sticky bottom tab bar (Home, Market, Squad, SBCs, Trader, Sync) with touch targets $\\ge 44\\text{px}$."
