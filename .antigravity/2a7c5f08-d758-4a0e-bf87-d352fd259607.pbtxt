            }
            lines {
              text: " * - Club: 2 -> +1, 4 -> +2, 7 -> +3"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - Nation: 2 -> +1, 5 -> +2, 8 -> +3"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - League: 3 -> +1, 5 -> +2, 8 -> +3"
