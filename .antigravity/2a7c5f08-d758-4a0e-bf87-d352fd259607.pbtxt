            lines {
              text: "## 1. Overview & Core Concept"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "### What It Does"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "The FC 27 Ultimate Team Assistant delivers a dedicated companion terminal powered by authentic console market pricing (PlayStation 5 / Xbox Series X|S / PC):"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "1. **AI SBC Recommendation Engine**: Automatically matches squad building challenges (Player of the Month, Icon Upgrades, Daily Gold Upgrades, Marquee Matchups) against both user club untradeables and console market fodder to find the mathematically lowest-cost solution."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "2. **Automated Investment Tracker**: Analyzes historical price charts, fodder demand curves, and promo schedules to recommend high-conviction flips, discard In-Forms, and meta snipes with automatic threshold alerts."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "3. **Real-Time Club & Game Sync**: Synchronizes coin balance, FC points, club roster, active Evolution objectives (games remaining, stat thresholds), and active in-game promotions with live auto-refresh."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "4. **FUTBIN-Grade Squad Builder**: 33/33 chemistry engine with club/nation/league links, manager league/nation boosts, Icon full chemistry rules, and custom tactics builder."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "### Target Audience & Persona"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "Active EA Sports FC 27 Ultimate Team players looking to maximize their club value, complete SBCs for the fewest coins, and trade systematically on mobile and dual-screen desktop laptops."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "### Key Value"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "Saves tens of thousands of coins per week on SBCs by prioritizing untradeables, prevents market losses via automated buy/sell alerts, and keeps all game data in real-time sync."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "**FC 27 UT App** provides console Ultimate Team players with a unified command center:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. **Club & Live Game Sync**: Real-time dashboard tracking your Coins, FIFA Points, untradeable/tradeable club roster, active Evolutions progress, active promos, and Google Drive cloud backups."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. **Console Market & Price Radar**: Real-time PlayStation/Xbox/PC player database with 24h/7d price graphs, fodder index tickers, and custom price alert triggers."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "3. **AI SBC Solver**: Evaluates active Squad Building Challenges against your club\'s existing player inventory and live market prices to minimize coin expenditure."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "4. **Automated Investment Tracker**: Generates AI-backed buy/sell calls, tracks active flips in your portfolio, deducts 5% EA tax automatically, and fires alerts when target prices hit."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "5. **33/33 Squad Builder & Voice AI Assistant**: Full formation pitch builder plus a multi-turn Gemini chat drawer with microphone transcription (`gemini-3.5-transcribe`) and live Google Search grounding."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
