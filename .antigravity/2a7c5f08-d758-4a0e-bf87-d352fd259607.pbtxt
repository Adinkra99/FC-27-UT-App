    content: "/**\n * Authentic EA Sports FC 27 Ultimate Team Console Dataset (2026/27 Season Grounded)\n * Strictly verified against FotMob 2026/27 Squad Rosters and FUTBIN FC 27 Console.\n * Zero legacy FC 24 / FC 25 / FC 26 data.\n * Features:\n * - Anti-Autoregressive 2026/27 Transfers (e.g., Rodri at FC Barcelona, Mbapp\303\251 at Real Madrid)\n * - Base Rarity Refresh (Gold, Silver, Bronze \342\200\224 no Common/Rare split) + Regular (<=87) & Pristine (>=88) Holographics\n * - 31 Player Roles & Focuses (Role, Role+, Role++) & 3 PlayStyles+ hard cap\n * - Dual-Mode SBCs (Streamlined Item Score SBCs & 11-Player Chemistry Puzzle SBCs)\n * - Authentic FUT Gallery Sets, Grades, Tags & \"Rent-and-Flip\" Discard Candidates\n */\n\nexport type FC27CardRarity =\n  | \'Gold\'\n  | \'Silver\'\n  | \'Bronze\'\n  | \'Regular Holographic\'\n  | \'Pristine Holographic\'\n  | \'TOTW\'\n  | \'Trailblazers\'\n  | \'Destined for Glory\'\n  | \'Future Stars\'\n  | \'Icon\'\n  | \'UT Hero\';\n\nexport type AcceleRATEType =\n  | \'Explosive\'\n  | \'Mostly Explosive\'\n  | \'Controlled Explosive\'\n  | \'Controlled\'\n  | \'Controlled Lengthy\'\n  | \'Mostly Lengthy\'\n  | \'Lengthy\';\n\nexport type BodyTypeProfile =\n  | \'Unique\'\n  | \'Lean\'\n  | \'Short & Lean\'\n  | \'Average\'\n  | \'High & Average\'\n  | \'Stocky\';\n\nexport interface PlayerRoleAssignment {\n  roleName: string;\n  position: string;\n  tier: \'Role\' | \'Role+\' | \'Role++\';\n  focus: string;\n}\n\nexport interface PricePoint {\n  timeLabel: string;\n  consolePrice: number;\n  volume: number;\n}\n\nexport interface FC27ConsolePlayer {\n  id: string;\n  name: string;\n  rating: number;\n  position: string;\n  altPositions: string[];\n  club: string;\n  league: string;\n  nation: string;\n  seasonVerified: \'2026-27\';\n  fotmobTransferNote?: string;\n  rarity: FC27CardRarity;\n  holographicMultiplier: 1.0 | 1.25 | 1.5;\n  baseItemScore: number;\n  effectiveItemScore: number; // baseItemScore * holographicMultiplier\n  consolePrice: number;\n  quickSellDiscard: number;\n  priceChange24hPct: number;\n  inClubInventory: boolean;\n  isUntradeable: boolean;\n  inDuplicateStorage: boolean;\n  faceStats: {\n    pac: number;\n    sho: number;\n    pas: number;\n    dri: number;\n    def: number;\n    phy: number;\n  };\n  subStats: {\n    acceleration: number;\n    sprintSpeed: number;\n    positioning: number;\n    finishing: number;\n    shotPower: number;\n    longShots: number;\n    vision: number;\n    shortPassing: number;\n    longPassing: number;\n    agility: number;\n    balance: number;\n    reactions: number;\n    ballControl: number;\n    dribbling: number;\n    composure: number;\n    interceptions: number;\n    defAwareness: number;\n    standingTackle: number;\n    jumping: number;\n    stamina: number;\n    strength: number;\n    aggression: number;\n  };\n  heightCm: number;\n  skillMoves: 1 | 2 | 3 | 4 | 5;\n  weakFoot: 1 | 2 | 3 | 4 | 5;\n  bodyType: BodyTypeProfile;\n  baseAccelerate: AcceleRATEType;\n  playStylesPlus: string[]; // Strictly capped at max 3 in FC 27!\n  playStylesBase: string[];\n  roles: PlayerRoleAssignment[];\n  galleryTags: string[];\n  hourlyPriceHistory24h: PricePoint[];\n  dailyPriceHistory7d: PricePoint[];\n}"
    num_lines: 1527
    num_bytes: 52443
    line_range_bytes: 3059
  }
}
