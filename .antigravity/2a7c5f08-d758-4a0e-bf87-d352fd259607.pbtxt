            lines {
              text: "```"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "### Temporal & Seasonal Utility Specification (`src/utils/timeGrounding.ts`)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "- `getBritishTimeContext(now = new Date())`:"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  - Formats exact `Europe/London` timestamp, weekday (e.g., `Wednesday`), date (`21 October 2026`), time (`HH:mm:ss BST/GMT`), and `T=0` ISO anchor."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  - Computes football season dynamically:"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    - If `month >= 8` (Aug\342\200\223Dec): `${year}-${String(year + 1).slice(-2)}` (`2026-27`, First Half of Season)."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    - If `month <= 5` (Jan\342\200\223May): `${year - 1}-${String(year).slice(-2)}` (e.g. May 2026 $\\rightarrow$ `2025-26`, End of Season)."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    - If `month` is Jun\342\200\223Jul: Off-season / Pre-season transition `${year}-${String(year + 1).slice(-2)}`."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
